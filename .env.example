YARNGPT_API_KEY=
GROQ_API_KEY=
YARNGPT_BASE_URL=https://api.yarngpt.ai/api/v1
GROQ_BASE_URL=https://api.groq.com/openai/v1
PORT=5001


SECRET_KEY=change-me-to-a-long-random-string
# VOICES_DB= (optional, defaults to Flask instance folder voices.db)

# Keep-alive pings GET /health through the public URL every 9 min so Render's
# 15-min idle timer never trips. On Render, RENDER_EXTERNAL_URL is provided
# automatically — set these only to override (or to test locally):
# KEEPALIVE_URL=https://nigtica-3mtt.onrender.com
# KEEPALIVE_INTERVAL_MIN=9

# Challenge demo login (optional — seeded on startup when both are set):
# DEMO_EMAIL=demo@nigtica.app
# DEMO_PASSWORD=change-me-too

GROQ_API_KEY=
# GROQ_BASE_URL=https://api.groq.com   (host only — the SDK adds /openai/v1)
# GROQ_STT_MODEL=whisper-large-v3-turbo
